name: Build Tor Binary for OpenWrt (aarch64-musl, dynamic)

on:
  workflow_dispatch:
  push:

env:
  OPENWRT_VERSION: 25.12.4
  TARGET_DIR: bcm27xx/bcm2711
  JOBS: 2

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y curl build-essential zstd file pkg-config

      - name: Extract OpenWrt SDK toolchain
        run: |
          SDK_INDEX="https://downloads.openwrt.org/releases/${OPENWRT_VERSION}/targets/${TARGET_DIR}/"
          html=$(curl -fsS "$SDK_INDEX")
          sdkfile=$(printf "%s" "$html" | grep -oP 'openwrt-sdk[^"]*bcm27xx-bcm2711[^"]*musl[^"]*Linux-x86_64\.tar\.zst' | head -1)
          
          if [ -z "$sdkfile" ]; then
            echo "Error: Could not find SDK"
            exit 1
          fi
          
          echo "Found SDK: $sdkfile"
          curl -fsSL "${SDK_INDEX}${sdkfile}" -o /tmp/sdk.tar.zst
          tar -xf /tmp/sdk.tar.zst -C /tmp
          
          SDK_DIR=$(tar -tf /tmp/sdk.tar.zst | head -1 | cut -f1 -d"/")
          SDK_PATH="/tmp/$SDK_DIR"
          
          echo "SDK_PATH=$SDK_PATH" >> $GITHUB_ENV
          
          # Extract just the toolchain files we need
          TOOLCHAIN_PATH="$SDK_PATH/staging_dir/toolchain-aarch64_cortex-a72_gcc-14.3.0_musl"
          echo "TOOLCHAIN_PATH=$TOOLCHAIN_PATH" >> $GITHUB_ENV
          
          # Add toolchain to PATH
          echo "$TOOLCHAIN_PATH/bin" >> $GITHUB_PATH
          
          # Verify toolchain exists
          if [ ! -f "$TOOLCHAIN_PATH/bin/aarch64-openwrt-linux-musl-gcc" ]; then
            echo "Error: Toolchain not found"
            exit 1
          fi
          echo "Toolchain verified at: $TOOLCHAIN_PATH"

      - name: Get latest Tor version
        id: tor_version
        run: |
          URL="https://dist.torproject.org/?C=M;O=D"
          LATEST_FILE=$(curl -s "$URL" | grep -o 'tor-[^"]*\.tar\.gz' | head -1)
          
          if [ -z "$LATEST_FILE" ]; then
            echo "Error: Could not find tor-*.tar.gz file"
            exit 1
          fi
          
          VERSION=$(echo "$LATEST_FILE" | sed 's/^tor-//; s/\.tar\.gz$//')
          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "Latest Tor version: $VERSION"

      - name: Download and extract Tor source
        run: |
          TOR_VERSION="${{ steps.tor_version.outputs.version }}"
          WORK_DIR="/tmp/tor-build-$$"
          mkdir -p "$WORK_DIR"
          
          echo "Downloading Tor $TOR_VERSION..."
          curl -fsSL "https://dist.torproject.org/tor-${TOR_VERSION}.tar.gz" -o "$WORK_DIR/tor.tar.gz"
          
          tar -xzf "$WORK_DIR/tor.tar.gz" -C "$WORK_DIR"
          
          echo "WORK_DIR=$WORK_DIR" >> $GITHUB_ENV
          echo "TOR_VERSION=$TOR_VERSION" >> $GITHUB_ENV
          echo "TOR_SRC_DIR=$WORK_DIR/tor-${TOR_VERSION}" >> $GITHUB_ENV

      - name: Configure Tor
        run: |
          cd "$TOR_SRC_DIR"
          
          export CC=aarch64-openwrt-linux-musl-gcc
          export CXX=aarch64-openwrt-linux-musl-g++
          export AR=aarch64-openwrt-linux-musl-ar
          export RANLIB=aarch64-openwrt-linux-musl-ranlib
          export STRIP=aarch64-openwrt-linux-musl-strip
          
          export CFLAGS="-O2 -pipe -fPIC"
          export CXXFLAGS="-O2 -pipe -fPIC"
          export LDFLAGS="-L${TOOLCHAIN_PATH}/lib"
          export CPPFLAGS="-I${TOOLCHAIN_PATH}/include"
          export PKG_CONFIG_PATH="${TOOLCHAIN_PATH}/lib/pkgconfig:${TOOLCHAIN_PATH}/share/pkgconfig"
          
          # Disable OpenSSL legacy provider if not needed
          ./configure \
            --host=aarch64-openwrt-linux-musl \
            --prefix=/usr \
            --sysconfdir=/etc \
            --localstatedir=/var \
            --disable-asciidoc \
            --disable-system-torrc \
            --disable-unittests \
            --disable-maintainer-mode \
            --with-openssl-dir=${TOOLCHAIN_PATH} \
            --with-libevent-dir=${TOOLCHAIN_PATH} \
            --with-zlib-dir=${TOOLCHAIN_PATH} \
            2>&1 | tee configure.log
          
          echo "=== Configuration complete ==="
          tail -20 configure.log

      - name: Build Tor
        run: |
          cd "$TOR_SRC_DIR"
          
          export CC=aarch64-openwrt-linux-musl-gcc
          export CXX=aarch64-openwrt-linux-musl-g++
          export AR=aarch64-openwrt-linux-musl-ar
          export RANLIB=aarch64-openwrt-linux-musl-ranlib
          export STRIP=aarch64-openwrt-linux-musl-strip
          
          export CFLAGS="-O2 -pipe -fPIC"
          export CXXFLAGS="-O2 -pipe -fPIC"
          export LDFLAGS="-L${TOOLCHAIN_PATH}/lib"
          export CPPFLAGS="-I${TOOLCHAIN_PATH}/include"
          export PKG_CONFIG_PATH="${TOOLCHAIN_PATH}/lib/pkgconfig:${TOOLCHAIN_PATH}/share/pkgconfig"
          
          echo "Building Tor $TOR_VERSION..."
          make -j${JOBS} 2>&1 | tee build.log
          
          if [ ${PIPESTATUS[0]} -ne 0 ]; then
            echo "Build failed! Last 50 lines of build log:"
            tail -50 build.log
            exit 1
          fi
          
          echo "=== Build complete ==="

      - name: Strip and verify binary
        run: |
          SOURCE_BINARY="$TOR_SRC_DIR/src/app/tor"
          
          if [ ! -f "$SOURCE_BINARY" ]; then
            echo "Error: Binary not found at $SOURCE_BINARY"
            echo "Directory contents:"
            find "$TOR_SRC_DIR/src" -name "tor" -type f
            exit 1
          fi
          
          echo "=== Binary Info Before Strip ==="
          file "$SOURCE_BINARY"
          ls -lh "$SOURCE_BINARY"
          
          # Check for dynamic linking
          if file "$SOURCE_BINARY" | grep -q "statically linked"; then
            echo "Warning: Binary appears to be statically linked!"
          fi
          
          # Strip the binary
          aarch64-openwrt-linux-musl-strip "$SOURCE_BINARY"
          
          echo "=== Binary Info After Strip ==="
          file "$SOURCE_BINARY"
          ls -lh "$SOURCE_BINARY"

      - name: Create artifact
        run: |
          mkdir -p /tmp/artifacts
          
          SOURCE_BINARY="$TOR_SRC_DIR/src/app/tor"
          ARTIFACT_NAME="tor-${TOR_VERSION}-openwrt-aarch64-musl-dynamic"
          ARTIFACT_PATH="/tmp/artifacts/${ARTIFACT_NAME}"
          
          cp "$SOURCE_BINARY" "$ARTIFACT_PATH"
          
          echo "=== Artifact Created ==="
          ls -lh "$ARTIFACT_PATH"
          file "$ARTIFACT_PATH"
          
          # Create info file
          cat > "/tmp/artifacts/BUILD_INFO.txt" << EOF
          Tor Binary Build Information
          =============================
          Version: ${TOR_VERSION}
          Target: OpenWrt aarch64 (bcm2711)
          Architecture: aarch64
          C Library: musl
          Linking: Dynamic
          Build Date: $(date -u)
          Toolchain: gcc-14.3.0
          
          Libraries:
          - OpenSSL 3.5.6
          - libevent 2.1.x
          - zlib
          - libcap
          
          Usage:
          1. Transfer binary to your OpenWrt device
          2. chmod +x tor
          3. Place in /usr/sbin/ or /usr/bin/
          4. Run: ./tor --version to verify
          
          EOF
          
          cat "/tmp/artifacts/BUILD_INFO.txt"

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: tor-openwrt-aarch64-musl-dynamic
          path: /tmp/artifacts/
          retention-days: 30
          if-no-files-found: error

      - name: Create Release (if tagged)
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v1
        with:
          files: /tmp/artifacts/*
          body_path: /tmp/artifacts/BUILD_INFO.txt
