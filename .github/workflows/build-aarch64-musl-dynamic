name: Build Tor Binary for OpenWrt (aarch64-musl)

on:
  workflow_dispatch:
  push:

env:
  OPENWRT_VERSION: 25.12.4
  TARGET_DIR: bcm27xx/bcm2711
  JOBS: 2
  TOR_VERSION: 0.4.8.12

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y curl build-essential zstd file

      - name: Extract OpenWrt SDK toolchain
        run: |
          SDK_INDEX="https://downloads.openwrt.org/releases/${OPENWRT_VERSION}/targets/${TARGET_DIR}/"
          html=$(curl -fsS "$SDK_INDEX")
          sdkfile=$(printf "%s" "$html" | grep -oP 'openwrt-sdk[^"]*bcm27xx-bcm2711[^"]*musl[^"]*Linux-x86_64\.tar\.zst' | head -1)
          echo "Found SDK: $sdkfile"
          curl -fsSL "${SDK_INDEX}${sdkfile}" -o /tmp/sdk.tar.zst
          tar -xf /tmp/sdk.tar.zst -C /tmp
          SDK_DIR=$(tar -tf /tmp/sdk.tar.zst | head -1 | cut -f1 -d"/")
          echo "SDK_DIR=$SDK_DIR" >> $GITHUB_ENV
          
          # Add toolchain to PATH
          echo "/tmp/$SDK_DIR/staging_dir/toolchain-aarch64_cortex-a72_gcc-14.3.0_musl/bin" >> $GITHUB_PATH

      - name: Build Tor (dynamically linked, aarch64-musl)
        run: |
          cd /tmp
          curl -fsSL "https://dist.torproject.org/tor-${TOR_VERSION}.tar.gz" -o tor.tar.gz
          tar -xzf tor.tar.gz
          cd tor-${TOR_VERSION}
          
          # Cross-compile for aarch64-musl
          ./configure \
            --host=aarch64-openwrt-linux-musl \
            --disable-asciidoc \
            --disable-system-torrc \
            --disable-unittests
          
          make -j${JOBS}
          aarch64-openwrt-linux-musl-strip src/app/tor
          
          # Create properly named binary
          BINARY_NAME="tor-${TOR_VERSION}-aarch64-musl-dynamic"
          cp src/app/tor "/tmp/${BINARY_NAME}"
          
          # Show binary information
          echo "=========================================="
          echo "Binary built successfully:"
          echo "=========================================="
          file "/tmp/${BINARY_NAME}"
          echo ""
          echo "Dynamic library dependencies:"
          aarch64-openwrt-linux-musl-readelf -d "/tmp/${BINARY_NAME}" | grep NEEDED || \
          aarch64-openwrt-linux-musl-objdump -p "/tmp/${BINARY_NAME}" | grep NEEDED
          echo ""
          echo "Binary size: $(ls -lh /tmp/${BINARY_NAME} | awk '{print $5}')"
          echo "=========================================="
          
          mkdir -p /tmp/artifacts
          cp "/tmp/${BINARY_NAME}" /tmp/artifacts/
          cp src/config/torrc.sample /tmp/artifacts/torrc.sample 2>/dev/null || true

      - name: Upload binary
        uses: actions/upload-artifact@v4
        with:
          name: tor-${TOR_VERSION}-aarch64-musl-dynamic
          path: /tmp/artifacts/
          if-no-files-found: warn
